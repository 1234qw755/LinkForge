<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="生成直链"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1D1B20"/>
        <TextView
            android:id="@+id/cancelBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#49454F"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 文件选择区 -->
            <LinearLayout
                android:id="@+id/dropZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/dash_border">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="42sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击选择文件，或选择多个文件"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1D1B20"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支持任意格式 · 可多选 · 无大小限制"
                    android:textSize="11sp"
                    android:textColor="#49454F"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- 已选文件 -->
            <LinearLayout
                android:id="@+id/fileInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/round_surface_low">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📄"
                    android:textSize="20sp"/>
                <TextView
                    android:id="@+id/fileInfoText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:textSize="12sp"
                    android:textColor="#1D1B20"
                    android:maxLines="2"/>
                <TextView
                    android:id="@+id/clearFile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="16sp"
                    android:textColor="#6750A4"/>
            </LinearLayout>

            <!-- 节点选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传节点（测速后显示延迟 / 不可达）"
                android:textSize="12sp"
                android:textColor="#49454F"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/nodeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/round_surface_low"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <TextView
                android:id="@+id/nodeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#79747E"
                android:layout_marginTop="4dp"/>

            <!-- 进度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp">
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:indeterminate="false"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/progressStage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="#49454F"/>
                    <TextView
                        android:id="@+id/progressPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#49454F"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 结果 -->
            <LinearLayout
                android:id="@+id/resultBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">
                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#6750A4"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:id="@+id/singleResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/round_surface_lowest"
                    android:padding="6dp">
                    <TextView
                        android:id="@+id/resultLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="#1D1B20"
                        android:paddingStart="10dp"
                        android:maxLines="2"
                        android:textIsSelectable="true"/>
                    <Button
                        android:id="@+id/copyBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="复制"
                        android:textSize="12sp"
                        android:textAllCaps="false"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/multiResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/multiList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                    <Button
                        android:id="@+id/copyAllBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="复制全部直链"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/resultNodeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#79747E"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">
        <Button
            android:id="@+id/bgContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="后台继续"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:visibility="gone"
            android:layout_marginEnd="10dp"/>
        <Button
            android:id="@+id/startUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始上传"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:enabled="false"
            android:alpha="0.5"/>
    </LinearLayout>

</LinearLayout>
