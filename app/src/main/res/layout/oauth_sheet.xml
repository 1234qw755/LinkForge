<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/oauthLogo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/oauthTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#1D1B20"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="将以你当前的账号继续"
        android:textSize="13sp"
        android:textColor="#49454F"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:id="@+id/oauthPerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/round_surface_low"
        android:padding="12dp"
        android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="标准 OAuth 2.0 授权。你需在服务商官方页面主动同意，本应用不读取密码、不抓取 Cookie；凭证仅存本机，可随时撤销。"
        android:textSize="10sp"
        android:textColor="#49454F"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">
        <Button
            android:id="@+id/oauthDeny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="拒绝"
            android:textSize="13sp"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/oauthAllow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="同意授权"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

</LinearLayout>
